# Development profile. Replace the secret and disable demo mode in production.
PROOFSTACK_ENV=development
PROOFSTACK_DEMO_MODE=true
PROOFSTACK_DATABASE_URL=sqlite:///./proofstack.db
PROOFSTACK_REDIS_URL=redis://localhost:6379/0
PROOFSTACK_TASK_BACKEND=inline
PROOFSTACK_RUNNER=native
PROOFSTACK_SECRET_KEY=replace-with-at-least-32-random-characters
PROOFSTACK_ACCESS_TOKEN_TTL=900
PROOFSTACK_REFRESH_TOKEN_TTL=604800
PROOFSTACK_MAX_UPLOAD_MB=25
PROOFSTACK_MAX_REPOSITORY_MB=100
PROOFSTACK_MAX_FILE_COUNT=10000
PROOFSTACK_COMMAND_TIMEOUT=120
PROOFSTACK_GITHUB_TOKEN=
PROOFSTACK_SEMGREP_ENABLED=false
PROOFSTACK_LLM_ENABLED=false
PROOFSTACK_LLM_BASE_URL=https://api.openai.com/v1
PROOFSTACK_LLM_API_KEY=
PROOFSTACK_LLM_MODEL=
PROOFSTACK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
PROOFSTACK_ARTIFACT_ROOT=.proofstack/artifacts
PROOFSTACK_WORKSPACE_ROOT=.proofstack/workspaces
PROOFSTACK_LOG_LEVEL=INFO

# Frontend development server configuration.
VITE_API_BASE_URL=http://localhost:8000/api/v1
